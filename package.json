{
  "name": "caption-forge-mcp",
  "version": "1.0.0",
  "description": "MCP server for subtitles: convert SRT/VTT/ASS, shift and retime, lint for readability, re-chunk into reel-style captions, search and extract transcripts. No dependencies on ffmpeg.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "caption-forge-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "start": "node dist/index.js",
    "test": "node --test test/*.test.mjs",
    "inspect": "npx -y @modelcontextprotocol/inspector node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "subtitles",
    "captions",
    "srt",
    "webvtt",
    "ass",
    "creator-tools",
    "reels",
    "claude"
  ],
  "author": "Anshuman",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anshumanofficial2002-cpu/caption-forge-mcp.git"
  },
  "homepage": "https://github.com/anshumanofficial2002-cpu/caption-forge-mcp#readme",
  "bugs": {
    "url": "https://github.com/anshumanofficial2002-cpu/caption-forge-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
